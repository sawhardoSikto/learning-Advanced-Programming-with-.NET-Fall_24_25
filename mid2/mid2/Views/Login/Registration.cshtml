
@{
    ViewBag.Title = "Registration";
}

<h2>Registration</h2>


@{
    bool checkGender(string gender)
    {
        if (Model.Gender != null && Model.Gender == gender)
        {
            return true;
        }
        return false;
    }
    bool checkProfession(string prof)
    {
        if (Model.Profession != null && Model.Profession == prof)
        {
            return true;
        }
        return false;
    }
    bool checkHobbies(string hobby)
    {
        if (Model.Hobbies != null)
        {
            foreach (var h in Model.Hobbies)
            {
                if (h == hobby)
                    return true;
            }
        }
        return false;
    }
}


<form action="" method="post">

    <input type="text" name="Id" class="form-control" value="@Model.Id" placeholder="Id" />
    <span class="text-danger">@Html.ValidationMessage("Id")</span>

    <input type="text" name="Name" class="form-control" value="@Model.Name" placeholder="Name" />
    <span class="text-danger">@Html.ValidationMessage("Name")</span>

    
    <input type="password" name="Password" class="form-control" value="@Model.Password" placeholder="Password" />
    <input type="email" name="Email" class="form-control" value="@Model.Email" placeholder="Email" />
    <span class="text-danger">@Html.ValidationMessage("Email")</span>
    <br />

    Gender:
    <input type="radio" checked="@checkGender("Male")" name="Gender" value="Male" /> Male
    <input type="radio" checked="@checkGender("Female")" name="Gender" value="Female" /> Female
    <br />
    <span class="text-danger">@Html.ValidationMessage("Gender")</span>
    <br />
    <br />
    Profession:
    <select name="Profession" class="form-control">
        <option disabled selected>--Select--</option>
        <option selected="@checkProfession("Student")" value="Student">Student</option>
        <option selected="@checkProfession("Teacher")" value="Teacher">Teacher</option>
        <option selected="@checkProfession("Developer")" value="Developer">Developer</option>
        <option value="Manager">Manager</option>
    </select>
    <span class="text-danger">@Html.ValidationMessage("Profession")</span>
    <br />
    Hobbies:
    <input type="checkbox" checked="@checkHobbies("Reading")" name="Hobbies[]" value="Reading" /> Reading
    <input type="checkbox" checked="@checkHobbies("Travelling")" name="Hobbies[]" value="Traveling" /> Traveling
    <input type="checkbox" checked="@checkHobbies("Gaming")" name="Hobbies[]" value="Gaming" /> Gaming
    <br />
    <span class="text-danger">@Html.ValidationMessage("Hobbies")</span>
    <label>Date of Birth</label>
    <br />
    <input type="date" name="DOB" class="form-control" />
    <span class="text-danger">@Html.ValidationMessage("DOB")</span>
    <br />

    <input type="submit" value="Register" class="btn btn-primary" />

</form>